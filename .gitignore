# Compiled binaries
*.exe
*.dll
*.so
*.dylib
/bin/
/dist/

# Binaries accidentally built in the repo root (e.g. `go build ./cmd/vpn-ca`,
# `make ca-init`). Prefer building into /bin/; these anchors keep a stray one
# out of a commit. .exe variants are covered by *.exe above.
/vpn-bot
/vpn-ca
/vpn-client
/vpn-ctl
/vpn-gui
/vpn-helper
/vpn-server

# Generated CA material — NEVER commit secrets
/ca-data/
*.key
*.pem

# Local planning notes — not part of the published project
/ROADMAP.md
/TECH_ROADMAP.md
/BUSINESS_PLAN.md

# Claude Code runtime/local files (lock files, per-user local settings)
.claude/*.lock
.claude/settings.local.json

# Generated UI mockup screenshots (regenerate from docs/ui/mockup.html)
docs/ui/shot-*.png

# IDE / editor
.idea/

# OS
.DS_Store
Thumbs.db
