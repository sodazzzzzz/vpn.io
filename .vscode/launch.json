{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "vpn-ca",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/vpn-ca",
            "args": ["help"]
        },
        {
            "name": "vpn-server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/vpn-server",
            "args": [
                "-listen", ":8443",
                "-ca", "ca-data/ca.crt",
                "-cert", "ca-data/server/server.crt",
                "-key", "ca-data/server/server.key",
                "-log-level", "debug"
            ]
        },
        {
            "name": "vpn-client",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/vpn-client",
            "args": [
                "-server", "127.0.0.1:8443",
                "-ca", "ca-data/ca.crt",
                "-cert", "ca-data/clients/alice.crt",
                "-key", "ca-data/clients/alice.key",
                "-server-name", "localhost",
                "-log-level", "debug"
            ]
        }
    ]
}
