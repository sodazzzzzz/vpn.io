[Unit]
Description=vpn.io VLESS/REALITY service (Xray-core)
Documentation=https://github.com/sodazzzzzz/vpn.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Unlike vpn-server, this one needs no root: it terminates a TCP listener and
# opens outbound sockets from the node's own stack — no TUN device, no routes,
# no NAT. The only privileged thing it does is bind 443, which the ambient
# capability below covers.
User=vpn-xray
Group=vpn-xray
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

Environment=XRAY_LOCATION_ASSET=/usr/local/share/xray
ExecStart=/usr/local/bin/xray run -config /etc/vpn-xray/config.json

Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15

# The config holds the node's REALITY private key and every client UUID, so the
# directory is the service's only writable path and nothing else on the box is
# reachable from here.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/vpn-xray
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
