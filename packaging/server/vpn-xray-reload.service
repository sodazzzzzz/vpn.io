[Unit]
Description=Restart vpn.io VLESS service after a config change
Documentation=https://github.com/sodazzzzzz/vpn.io/blob/main/docs/VLESS.md
# Nothing to do if the service is not installed or not wanted.
Requisite=vpn-xray.service

[Service]
Type=oneshot
# The debounce and — crucially — the "is this already applied?" guard live in
# the script. A bare sleep+restart here turns an extra path trigger into a
# service that restarts every few seconds forever; the script compares the
# config's timestamp with the service's start time and does nothing when the
# running process is already newer. See apply-config.sh.
ExecStart=/usr/local/lib/vpn-xray/apply-config.sh
