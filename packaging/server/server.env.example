# vpn.io server configuration — copy to /etc/vpn-server/server.env and edit.
# Read by the systemd unit (EnvironmentFile). Restart after changes:
#     sudo systemctl restart vpn-server

# --- Credentials (copy these THREE files from your CA host; never the ca.key) ---
VPN_CA=/etc/vpn-server/ca.crt
VPN_CERT=/etc/vpn-server/server.crt
VPN_KEY=/etc/vpn-server/server.key

# --- Revocation (optional) ---
# Deny-list of revoked client serials, written by `vpn-ca revoke` (and the bot's
# /revoke). Point this at the revoked.json in your CA directory; the server
# hot-reloads it, so a revoke takes effect on the client's next connection with
# no restart. Leave empty to disable revocation.
VPN_REVOKED=

# --- Network ---
# Listen address (open this TCP port in the provider's firewall too).
VPN_LISTEN=:8443
# Tunnel subnet and the server's address inside it (the clients' gateway).
VPN_SUBNET=10.8.0.0/24
VPN_GATEWAY=10.8.0.1

# Routes pushed to clients (comma-separated, NO spaces). 0.0.0.0/0 = full tunnel
# (all traffic via the VPN); for split-tunnel use e.g. 10.0.0.0/8,192.168.0.0/16.
VPN_PUSH_ROUTES=0.0.0.0/0
# DNS resolvers pushed to clients (comma-separated).
VPN_PUSH_DNS=1.1.1.1,9.9.9.9

# --- NAT ---
# The server's WAN (public) network interface, used for MASQUERADE. Find it with:
#     ip route get 1.1.1.1
# (the word after "dev", commonly eth0 / ens3 / enp1s0).
VPN_WAN=eth0
