[Unit]
Description=vpn.io privileged helper daemon
Documentation=https://github.com/sodazzzzzz/vpn.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as root (uid 0): the helper creates the TUN device and edits routes, the
# nftables firewall and DNS — do not drop the user. Group=vpn-io makes the
# control socket in /run/vpn-io group-owned by vpn-io so a member can reach it
# on the filesystem. Authorisation is by uid (-allow-uid ${VPNIO_UID}, written
# to /etc/default/vpn-helper by the package): SO_PEERCRED reports the peer's uid
# and *primary* gid, not supplementary groups, so the uid is the reliable,
# race-free identity to match. Root uid keeps full privileges regardless of the
# group. EnvironmentFile is required (no '-'): a missing file fails the service
# loudly rather than silently starting root-only.
Group=vpn-io
EnvironmentFile=/etc/default/vpn-helper
ExecStart=/usr/bin/vpn-helper -socket /run/vpn-io/helper.sock -socket-mode 0660 -allow-uid ${VPNIO_UID} -log-level info

# systemd creates /run/vpn-io (root:vpn-io, 0750) on start and removes it on
# stop — group-traversable so a vpn-io member can reach the socket.
RuntimeDirectory=vpn-io
RuntimeDirectoryMode=0750

Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=15

# Defence-in-depth: these don't interfere with creating the TUN device,
# netlink/route changes, the nftables firewall or the unix socket — but they
# shrink the blast radius of a root daemon that terminates TLS traffic.
NoNewPrivileges=yes
PrivateTmp=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
ProtectClock=yes
ProtectKernelLogs=yes

[Install]
WantedBy=multi-user.target
