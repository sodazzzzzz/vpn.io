[Unit]
Description=vpn.io privileged helper daemon
Documentation=https://github.com/sodazzzzzz/vpn.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The helper must run as root: it creates the TUN device and edits routes,
# the nftables firewall and DNS. Do not add User=/drop privileges here.
ExecStart=/usr/local/bin/vpn-helper -socket /run/vpn-io/helper.sock -socket-mode 0660 -log-level info
#
# To let a desktop user drive the daemon, grant their group and make the
# socket group-accessible by appending, e.g.:
#     -allow-gid 1000
# (see packaging/README.md). The default admits only root.

# Private runtime directory for the control socket: systemd creates
# /run/vpn-io on start and removes it on stop. 0750 keeps it from being
# world-traversable (the socket itself is root-only by default; this just
# avoids advertising its existence). Widen it alongside the socket when
# granting a non-root group access.
RuntimeDirectory=vpn-io
RuntimeDirectoryMode=0750

Restart=on-failure
RestartSec=2

# The helper tears the tunnel down on SIGTERM; give it room to finish.
KillSignal=SIGTERM
TimeoutStopSec=15

# Defence-in-depth: these don't interfere with creating the TUN device,
# netlink/route changes, the nftables firewall or the unix socket — but they
# shrink the blast radius of a root daemon that terminates TLS traffic. Kept in
# sync with packaging/deb/vpn-helper.service (same binary, same privileges).
NoNewPrivileges=yes
PrivateTmp=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
ProtectClock=yes
ProtectKernelLogs=yes

[Install]
WantedBy=multi-user.target
