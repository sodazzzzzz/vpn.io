#!/bin/sh
# Runs as root after the payload is written. Authorises the desktop user and
# starts the helper LaunchDaemon.
set -eu

LABEL=io.vpnio.helper
PLIST="/Library/LaunchDaemons/${LABEL}.plist"

# Authorise the user sitting at the console by uid. The helper checks the peer's
# uid from the kernel (LOCAL_PEERCRED), so this is reliable and — unlike a group
# — needs no logout/login to take effect. Default to 0 (root only) if we can't
# tell who that is: a safe degraded state rather than admitting everyone.
ALLOW_UID=0
CONSOLE_USER=$(stat -f %Su /dev/console 2>/dev/null || true)
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
	ALLOW_UID=$(id -u "$CONSOLE_USER" 2>/dev/null || echo 0)
fi

# pkgbuild always lays down the fresh template, so the placeholder is present on
# every (re)install — replace it with the resolved uid.
/usr/bin/sed -i '' "s/__ALLOW_UID__/${ALLOW_UID}/" "$PLIST"

# Load and start the daemon (replace any earlier instance first).
launchctl bootout "system/${LABEL}" 2>/dev/null || true
launchctl bootstrap system "$PLIST"
launchctl enable "system/${LABEL}"

if [ "$ALLOW_UID" = "0" ]; then
	echo "vpn.io: could not detect the desktop user — the helper is root-only."
	echo "        Authorise a user manually, then reload:"
	echo "          sudo sed -i '' \"s/-allow-uid [0-9]*/-allow-uid \$(id -u <user>)/\" ${PLIST}"
	echo "          sudo launchctl bootout system/${LABEL}; sudo launchctl bootstrap system ${PLIST}"
else
	echo "vpn.io: authorised ${CONSOLE_USER} (uid ${ALLOW_UID}). Open vpn.io and connect."
fi

exit 0
